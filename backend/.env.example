FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ministry_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Mail Config (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_email_password

# Upload folder (relative to backend root)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600

# Frontend origin + CORS. In production set CORS_ORIGINS to your real domain,
# e.g. CORS_ORIGINS=https://yourministry.com,https://www.yourministry.com
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# Paystack — get keys at https://dashboard.paystack.com/#/settings/developer
# Secret key stays on the backend only. Never expose sk_ in frontend code.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
